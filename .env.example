OPENROUTER_API_KEY=sk-or-...
CHAT_MODEL=openai/gpt-4.1-mini
EMBED_MODEL=openai/text-embedding-3-small

# Modo híbrido (opcional). O Jev roda pelo OpenRouter com a mesma OPENROUTER_API_KEY.
# JEV_MODEL=jev-latest        # ou uma versão fixa, ex.: jev-1.13
# ROUTE_THRESHOLD=0.8         # confiança mínima para mandar a pergunta ao RAG simples
# EVIDENCE_THRESHOLD=0.5      # abaixo disso, o agente é mandado buscar mais uma vez
